# Public-testnet token provisioning only. This file contains no private key.
# Use Node's --env-file option; do not shell-source operator configuration.
CHAIN_ENV=testnet
RPC_URL=https://replace-with-private-testnet-evm-rpc.example
# Keep false for HTTPS. The exact acknowledgement below is permitted only for
# the current evaluation testnet when the operator has no TLS RPC endpoint.
ALLOW_INSECURE_TESTNET_RPC=false
# Current evaluation public testnet (use these together when TLS is absent):
# RPC_URL=http://54.165.44.130:8545
# ALLOW_INSECURE_TESTNET_RPC=acknowledge-evaluation-only-plaintext-rpc
AETHELRED_CHAIN_ID=7332
AETHELRED_NETWORK_ANCHOR_BLOCK=450000
AETHELRED_NETWORK_ANCHOR_HASH=0x1057a62d12eed50d8740fcf51be0cd784db9a4f8f98c9312eee8b8bc7e543ddc
NOBLEPAY_SOURCE_COMMIT=replace-with-reviewed-40-character-commit

# The key remains in a separate regular file with mode 0400 or 0600. The
# command rejects inline DEPLOYER_KEY and PRIVATE_KEY variables.
TOKEN_PROVISIONER_ADDRESS=0xreplace-with-funded-testnet-provisioner
TOKEN_PROVISIONER_KEY_FILE=/etc/noblepay/token-provisioner.key

# To reuse the already deployed USDC, provide both its address and exact
# on-chain name. The ceremony verifies reviewed MockERC20 runtime bytecode,
# symbol USDC, six decimals, and the exact name before adopting it. Leave the
# USDT pair empty to deploy only the missing USDT contract. If USDT already
# exists, fill both USDT values and the ceremony will verify/adopt it too.
EXISTING_USDC_TOKEN_ADDRESS=
EXISTING_USDC_TOKEN_NAME=
EXISTING_USDT_TOKEN_ADDRESS=
EXISTING_USDT_TOKEN_NAME=

# Keep false for --validate-only. For the transaction-bearing run, set the
# exact phrase printed below, then return it to false immediately afterward.
CONFIRM_TESTNET_TOKEN_PROVISIONING=false
# CONFIRM_TESTNET_TOKEN_PROVISIONING=deploy-publicly-mintable-test-tokens
