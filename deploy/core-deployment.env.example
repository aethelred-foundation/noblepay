# NoblePay core contract deployment inputs.
# Copy outside the repository, chmod 0600, and inject through a secret manager.
# Never place a real deployer key in this checked-in example.

CHAIN_ENV=testnet
RPC_URL=https://private-rpc-operator.example.com
AETHELRED_CHAIN_ID=replace-with-us-team-confirmed-chain-id
# Both phases query this exact immutable block through RPC and reject any hash
# other than the value confirmed independently by the US network operator.
AETHELRED_NETWORK_ANCHOR_BLOCK=replace-with-us-team-confirmed-immutable-block-number
AETHELRED_NETWORK_ANCHOR_HASH=replace-with-us-team-confirmed-immutable-block-hash

# Temporary, funded bootstrap signer. This address must not be reused for any
# final governance or operational role below.
DEPLOYER_KEY=replace-with-secret-manager-reference
DEPLOYER_ADDRESS=0x1111111111111111111111111111111111111111

# Final governance and role holders. On testnet/mainnet ADMIN_ADDRESS must be a
# deployed multisig contract able to execute SealSettlementGate.acceptOwnership()
# between the two phases.
ADMIN_ADDRESS=0x2222222222222222222222222222222222222222
TREASURY_MANAGER_ADDRESS=0x3333333333333333333333333333333333333333
BUSINESS_VERIFIER_ADDRESS=0x4444444444444444444444444444444444444444
# Dedicated external compliance-operator EOA. Safe/contract/module/relay
# addresses are unsupported: both phases require eth_getCode(address) == 0x,
# while the managed hardware/service signing key stays outside NoblePay.
TEE_NODE_ADDRESS=0x5555555555555555555555555555555555555555
COMPLIANCE_OFFICER_ADDRESS=0x6666666666666666666666666666666666666666

# Fee beneficiary only. It deliberately does not receive TREASURY_ROLE and
# must differ from TREASURY_MANAGER_ADDRESS.
TREASURY_ADDRESS=0x7777777777777777777777777777777777777777

# Public testnet: copy these three values from either the independently
# confirmed canonical-token record or the finalized output of
# scripts/provision-testnet-tokens.mjs. Example addresses are not evidence.
SUPPORTED_TOKEN_ADDRESSES=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
USDC_TOKEN_ADDRESS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
USDT_TOKEN_ADDRESS=0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

NOBLEPAY_BASE_FEE=100000
NOBLEPAY_PERCENTAGE_FEE=25
PAYMENT_CHANNEL_FEE_BPS=25
CEAP_ALLOWED_BACKENDS=TDX,SEV-SNP
CEAP_MIN_VERIFICATION=HARDWARE
CEAP_ALLOWED_PLATFORMS=linux-amd64
CEAP_REQUIRE_VENDOR_ROOT=true
CEAP_DATA_RESIDENCY=AE,US
SEAL_PROBE_ID=operator-confirmed-probe-seal-id

# Pass an absolute, host-only checkpoint path with --checkpoint-file for both
# phases. The script creates/updates that mode-0600 JSON file atomically after
# every confirmed deployment. Do not copy the JSON into this env file, clear
# it, or change paths between bootstrap and finalize.

# Required only by --finalize. These values are withheld from bootstrap output.
PUBLIC_AETHELRED_RPC_URL=https://public-rpc-operator.example.com
PUBLIC_AETHELRED_WS_URL=wss://public-ws-operator.example.com
PUBLIC_AETHELRED_EXPLORER_URL=https://explorer-operator.example.com
FRONTEND_SITE_URL=https://noblepay.example.com
FRONTEND_API_URL=https://noblepay.example.com/api
FRONTEND_WS_URL=wss://noblepay.example.com/ws
WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id
FRONTEND_APP_VERSION=1.0.0
FRONTEND_SENTRY_DSN=
