# Copy to a host-only file with mode 0600. Never commit populated values.
POSTGRES_USER=noblepay
POSTGRES_PASSWORD=replace-with-url-safe-random-secret
POSTGRES_DB=noblepay

JWT_SECRET=replace-with-at-least-32-random-bytes
COMPLIANCE_API_KEY=replace-with-random-service-key
COMPLIANCE_API_URL=https://replace-with-audited-compliance-service-origin
COMPLIANCE_MAX_DATASET_AGE_HOURS=24
TRAVEL_RULE_THRESHOLD_USD=1000.00
TRAVEL_RULE_ACTIVE_KEY_ID=replace-with-active-key-id
TRAVEL_RULE_ENCRYPTION_KEYS={"replace-with-active-key-id":"replace-with-canonical-base64-32-byte-key="}

# Optional governed delivery adapter. Evidence generation remains available
# when these are empty; no filing is represented as externally submitted.
REGULATORY_REPORTING_URL=
REGULATORY_REPORTING_API_KEY=

# Required only when the optional `gateway` Compose profile is enabled.
# Leave these empty for the base frontend/backend stack.
GATEWAY_API_KEY=
WEBHOOK_SECRET=

PUBLIC_ORIGIN=https://noblepay.example.com
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
GATEWAY_BIND_ADDRESS=127.0.0.1

# These example hosts are intentionally non-live. Replace chain/contract values
# only from DEPLOYMENT_MANIFEST_JSON emitted by --finalize; bootstrap's
# HANDOFF_PENDING_JSON is intentionally not application configuration. Replace
# all public hosts only after the US network operator confirms the activated
# network and exact chain ID.
# AETHELRED_RPC_URL is private/server-only and may use a separate provider.
AETHELRED_RPC_URL=https://private-rpc-operator.example.com
PUBLIC_AETHELRED_RPC_URL=https://public-rpc-operator.example.com
PUBLIC_AETHELRED_WS_URL=wss://public-ws-operator.example.com
PUBLIC_AETHELRED_EXPLORER_URL=https://explorer-operator.example.com
NOBLEPAY_CHAIN_ID=replace-with-us-team-confirmed-chain-id
AETHELRED_NETWORK_ANCHOR_BLOCK=replace-with-us-team-confirmed-immutable-block-number
AETHELRED_NETWORK_ANCHOR_HASH=replace-with-us-team-confirmed-immutable-block-hash
NOBLEPAY_CONTRACT_ADDRESS=0x1111111111111111111111111111111111111111
BUSINESS_REGISTRY_CONTRACT_ADDRESS=0x2222222222222222222222222222222222222222
BUSINESS_VERIFIER_ADDRESS=0x4444444444444444444444444444444444444444
PAYMENT_CHANNELS_ADDRESS=0x5555555555555555555555555555555555555555
NOBLEPAY_MIN_CONFIRMATIONS=2
NOBLEPAY_TOKEN_CONFIG={"0x6666666666666666666666666666666666666666":{"currency":"USDC","currencyCode":"USD","decimals":6},"0x7777777777777777777777777777777777777777":{"currency":"USDT","currencyCode":"USD","decimals":6}}
USDC_TOKEN_ADDRESS=0x6666666666666666666666666666666666666666
USDT_TOKEN_ADDRESS=0x7777777777777777777777777777777777777777

NEXT_PUBLIC_CHAIN_ENV=testnet
NEXT_PUBLIC_API_URL=https://noblepay.example.com/api
NEXT_PUBLIC_WS_URL=wss://noblepay.example.com/ws
WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=1.0.0

# Gateway-only. Set this to the verified NoblePay deployment block before
# enabling the `gateway` profile. The gateway also reuses NOBLEPAY_CHAIN_ID and
# the immutable AETHELRED_NETWORK_ANCHOR_* values above, and verifies all three
# at startup, before every poll, and before every webhook projection.
INDEXER_START_BLOCK=
INDEXER_CONFIRMATIONS=2
GATEWAY_TRUSTED_PROXY_CIDRS=
COMPLIANCE_TIMEOUT_SECS=5
INDEXER_POLL_INTERVAL_SECS=10
LOG_LEVEL=info
