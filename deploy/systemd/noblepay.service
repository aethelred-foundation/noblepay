# NoblePay frontend — systemd unit (standalone production build, port 3008)
#
# NOTE: NEXT_PUBLIC_* variables are baked in at BUILD time — rebuild with the
# correct values before (re)starting this service:
#   cp deploy/production.env.example /etc/aethelred/noblepay.env
#   # replace every placeholder, then build using the reviewed environment
#
# Install:
#   1. Install Node 24.18.0 and npm at /usr/bin/npm.
#   2. Create the `noblepay` service account and place the reviewed release at
#      /opt/aethelred/noblepay, owned by that account.
#   3. sudo cp deploy/systemd/noblepay.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now noblepay
#   Logs: journalctl -u noblepay -f

[Unit]
Description=NoblePay frontend (Next.js standalone, port 3008)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=noblepay
Group=noblepay
WorkingDirectory=/opt/aethelred/noblepay
Environment=NODE_ENV=production
Environment=PORT=3008
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/npm run start:standalone
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
